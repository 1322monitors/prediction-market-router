# Required
# 1322 X/Twitter API key. Must match the tier selected by WS_TIER below
# (a normal-tier key will not authenticate against the ultimate WS endpoint,
# and vice versa). Get a key at https://1322.io/pricing.
X_API_KEY=YOUR_API_KEY_HERE

# Outbound webhook that receives matched events as an HTTP POST with a JSON
# body. Point this at whatever you use downstream (a queue ingestion URL, a
# serverless function, a logging endpoint, your own prediction-market
# resolution pipeline, etc).
WEBHOOK_URL=https://example.com/your-webhook-endpoint

# Optional
# WS_TIER=normal
# KEYWORDS_FILE=config/keywords.json
# TRACK_ACCOUNTS=elonmusk,twitter
# WEBHOOK_TIMEOUT_MS=5000
# DEDUP_TTL_MS=600000
# DEDUP_MAX_ENTRIES=5000
